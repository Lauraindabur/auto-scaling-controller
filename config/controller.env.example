# Plantilla de configuracion del controller.
#
#   cp config/controller.env.example config/controller.env
#   # edita las 4 claves de identidad con los valores de tu cuenta
#   set -a; . config/controller.env; set +a
#
# config/controller.env esta en .gitignore: no se versiona porque lleva
# identificadores de la cuenta. Este archivo solo tiene valores de relleno.
#
# Las claves de identidad son obligatorias y no tienen valor por defecto: el
# controller no arranca sin ellas. Todas las demas tienen el valor por defecto
# que aparece aqui, que es el calibrado en las pruebas del 23-sep-2026.

# --- Identidad de la infraestructura (obligatorias) ---
# Nombre del Auto Scaling Group (dimension AutoScalingGroupName de AWS/EC2).
export ASG_NAME="MI-ASG"
export REGION="us-east-1"
# Dimensiones de AWS/ApplicationELB tal como las publica el ALB. Son el sufijo del
# ARN a partir de 'app/' y de 'targetgroup/' respectivamente. Se sacan con:
#   aws elbv2 describe-load-balancers --query 'LoadBalancers[].LoadBalancerArn'
#   aws elbv2 describe-target-groups  --query 'TargetGroups[].TargetGroupArn'
export LOAD_BALANCER_DIM="app/MI-ALB/0000000000000000"
export TARGET_GROUP_DIM="targetgroup/MI-TG/0000000000000000"

# --- Ciclo de control ---
# Se consulta CloudWatch cada POLL_INTERVAL_SEG, pero solo se decide cuando llega un
# periodo nuevo: asi no se procesa el mismo dato dos veces (inflaria la tendencia de Holt).
export POLL_INTERVAL_SEG=30
export PERIOD_SEG=60
# Si el periodo mas reciente es mas viejo que esto, el dato se considera incompleto
# y la decision es MAINTAIN. Debe ser >= PERIOD_SEG.
export MAX_DATA_AGE_SEG=180

# --- Reactivo: umbrales estaticos sobre la CPU suavizada ---
# Invariante obligatoria: 2 x UMBRAL_BAJO < UMBRAL_ALTO, para que bajar de 2
# instancias a 1 no deje la CPU por encima del umbral de subida.
export UMBRAL_ALTO=70
export UMBRAL_BAJO=30
# Holgura del chequeo n-1: para bajar se exige CPU proyectada < UMBRAL_ALTO - MARGEN_BAJADA.
export MARGEN_BAJADA=10
# Muestras de la media movil. Es solo un filtro de ruido, no un pronostico.
export MA_VENTANA=3

# --- Proactivo: Holt (double exponential smoothing) sobre RequestCount ---
export HOLT_ALPHA=0.5
export HOLT_BETA=0.3
# Horizonte del pronostico, en periodos. 2 periodos de 60 s cubren el warm-up
# medido (90-120 s desde desired hasta healthy en el Target Group).
export HORIZONTE_PERIODOS=2
# Capacidad de UNA instancia en peticiones por minuto, al ~70 % de CPU.
# 480 RPM = 8 req/s, medido sobre t2.micro. Recalibrar si cambia el tipo de instancia
# o el costo por peticion de la app.
export C_RPM=480

# --- Guardas de seguridad ---
export COOLDOWN_SUBIDA_SEG=120
# COOLDOWN_BAJADA_SEG debe cumplir >= (MA_VENTANA + 1) x PERIOD_SEG, para que la MA de
# CPU deje de arrastrar la capacidad de antes del ultimo recorte. Con MA_VENTANA=3 y
# PERIOD_SEG=60 el minimo es 240 s (3 periodos de la MA + 1 de margen por el retraso de
# publicacion de CloudWatch).
export COOLDOWN_BAJADA_SEG=240
# Si "hay capacidad en camino" (Pending > 0 o HealthyHostCount < InService) dura mas
# que esto, se asume una instancia atascada: se registra un WARN y esa guarda deja de
# bloquear la subida, para no quedar sin poder escalar indefinidamente.
export WARMUP_TIMEOUT_SEG=600
export MIN_CAPACITY=1
export MAX_CAPACITY=5

# --- Salidas ---
# STATE_FILE sobrevive a los reinicios: guarda la ventana de la media movil, el estado
# de Holt y los timestamps de la ultima subida y bajada. Su directorio esta en .gitignore.
export STATE_FILE="state/controller_state.json"
export LOG_FILE="logs/decisions.jsonl"
