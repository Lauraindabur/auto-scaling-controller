[Unit]
Description=App Flask del controller (endpoint de carga /health)
After=network.target

[Service]
# Root porque escucha en el puerto 80 (puerto privilegiado), igual que hacia
# el nohup del user-data.sh original.
User=root
ExecStart=/usr/bin/python3 /home/ubuntu/app.py
Restart=always
RestartSec=2
StandardOutput=append:/home/ubuntu/app.log
StandardError=append:/home/ubuntu/app.log

[Install]
WantedBy=multi-user.target
